# Copy to .env.local and fill in from Supabase Dashboard → Project Settings → API.
# The anon key is designed to be public (RLS protects the data), but keep real
# values out of the repo anyway. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
